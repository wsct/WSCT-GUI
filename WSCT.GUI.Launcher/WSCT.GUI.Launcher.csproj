<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<VersionPrefix>2.0.0</VersionPrefix>
		<VersionSuffix>alpha</VersionSuffix>
		<TargetFramework>net10.0</TargetFramework>
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WSCT.GUI.Launcher</PackageId>
		<Description>Blazor Server Launcher of WSCT GUI configured with default plugins.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plugin Interactive Layer\Plugin Interactive Layer.csproj" />
		<ProjectReference Include="..\Plugin ISO7816 Tools\Plugin ISO7816 Tools.csproj" />
		<ProjectReference Include="..\WSCT.GUI\WSCT.GUI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Stack.Channel.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Stack.Context.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="..\Plugin ISO7816 Tools\ISO7816\Dictionary.StatusWord.xml">
			<Link>ISO7816\Dictionary.StatusWord.xml</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>