<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<Version>2.4.1</Version>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>Layer.Interactive</AssemblyName>
		<RootNamespace>WSCT.Layers.Interactive</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WSCT.Layers.Interactive</PackageId>
		<Description>WSCT Layer allowing basic interception of CRP and replay of previously intercepted CRP.</Description>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WSCT.Core" />
	</ItemGroup>
</Project>