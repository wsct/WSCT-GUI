@using System.Xml
@using System.Xml.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using WSCT.Layers.Interactive
@using WSCT.Layers.Interactive.Actions
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white py-2">
        <i class="bi bi-sliders me-1"></i> Interactive Layer Controller
    </div>
    <div class="card-body">
        <div class="row g-4">
            <!-- Left: Fake Reader Settings -->
            <div class="col-md-6">
                <div class="card h-100 border-light bg-light">
                    <div class="card-header bg-white fw-bold small">
                        <i class="bi bi-sim me-1"></i> Interactive Smartcard Reader
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="chkFakeReader"
                                   checked="@InteractiveController.UseFakeReader"
                                   @onchange="OnUseFakeReaderChanged" />
                            <label class="form-check-label fw-semibold" for="chkFakeReader">
                                Use Fake Smartcard Reader
                            </label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Reader Name</label>
                            <input type="text" class="form-control form-control-sm"
                                   value="@InteractiveController.FakeReaderName"
                                   @oninput="OnFakeReaderNameChanged" />
                            <div class="form-text small">Simulated reader name exposed to SCardListReaders.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Interactive Mode -->
            <div class="col-md-6">
                <div class="card h-100 border-light bg-light">
                    <div class="card-header bg-white fw-bold small">
                        <i class="bi bi-gear-wide-connected me-1"></i> Interactive Mode
                    </div>
                    <div class="card-body">
                        <label class="form-label small fw-semibold">Current Operating Mode</label>
                        <select class="form-select form-select-sm mb-3"
                                value="@InteractiveController.Mode"
                                @onchange="OnModeChanged">
                            @foreach (InteractiveMode mode in Enum.GetValues(typeof(InteractiveMode)))
                            {
                                <option value="@mode">@mode</option>
                            }
                        </select>
                        <div class="small text-muted">
                            @switch (InteractiveController.Mode)
                            {
                                case InteractiveMode.Transparent:
                                    <span>Passes all calls directly to the physical smart card.</span>
                                    break;
                                case InteractiveMode.Record:
                                    <span>Transparently passes calls while capturing interactions into memory.</span>
                                    break;
                                case InteractiveMode.Replay:
                                    <span>Acts as an automated simulator by returning recorded answers without hardware.</span>
                                    break;
                                case InteractiveMode.Emulator:
                                    <span>Commands are routed to an attached software emulator plugin.</span>
                                    break;
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom: HTML5 Import / Export -->
            <div class="col-12">
                <div class="card border-light bg-light">
                    <div class="card-header bg-white fw-bold small d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-file-earmark-code me-1"></i> Interactive Records Import / Export (HTML5)</span>
                        <span class="badge bg-secondary">@InteractiveController.ActionsList.Count recorded actions</span>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center g-3">
                            <!-- Import via HTML5 InputFile -->
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">
                                    <i class="bi bi-upload me-1 text-primary"></i> Load Replay Data (.xml)
                                </label>
                                <InputFile OnChange="LoadReplayDataAsync" class="form-control form-control-sm" accept=".xml" />
                                <div class="form-text small">Upload previously exported XML actions to switch to Replay mode.</div>
                            </div>

                            <!-- Export via HTML5 Download -->
                            <div class="col-md-6 text-md-end">
                                <label class="form-label small fw-semibold d-block text-md-end">
                                    <i class="bi bi-download me-1 text-success"></i> Save Recorded Actions
                                </label>
                                <button class="btn btn-success btn-sm px-3"
                                        @onclick="SaveRecordedDataAsync"
                                        disabled="@(InteractiveController.ActionsList.Count == 0)">
                                    <i class="bi bi-save me-1"></i> Download InteractiveData.xml
                                </button>
                                <div class="form-text small">Download current in-memory actions list to an XML file.</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_statusMessage))
                        {
                            <div class="alert alert-info py-2 px-3 mt-3 mb-0 small">
                                <i class="bi bi-info-circle me-1"></i> @_statusMessage
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _statusMessage = string.Empty;

    protected override void OnInitialized()
    {
        InteractiveController.InteractiveModeChangedEvent += OnInteractiveModeChanged;
    }

    private void OnInteractiveModeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnUseFakeReaderChanged(ChangeEventArgs e)
    {
        InteractiveController.UseFakeReader = (bool)(e.Value ?? false);
    }

    private void OnFakeReaderNameChanged(ChangeEventArgs e)
    {
        InteractiveController.FakeReaderName = e.Value?.ToString() ?? string.Empty;
    }

    private void OnModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<InteractiveMode>(e.Value?.ToString(), out var mode))
        {
            InteractiveController.Mode = mode;
        }
    }

    private async Task LoadReplayDataAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            var serializer = new XmlSerializer(typeof(ActionsContainer));
            using var reader = XmlReader.Create(stream);

            if (serializer.Deserialize(reader) is ActionsContainer container)
            {
                InteractiveController.ActionsList = container.ActionsList;
                InteractiveController.Mode = InteractiveMode.Replay;
                InteractiveController.ActionsListId = 0;
                _statusMessage = $"Successfully loaded {container.ActionsList.Count} actions from '{file.Name}' and activated Replay mode.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error loading replay file: {ex.Message}";
        }
    }

    private async Task SaveRecordedDataAsync()
    {
        try
        {
            var container = new ActionsContainer(InteractiveController.ActionsList);
            var serializer = new XmlSerializer(typeof(ActionsContainer));
            using var stringWriter = new StringWriter();
            using var xmlWriter = XmlWriter.Create(stringWriter, new XmlWriterSettings { Indent = true });
            serializer.Serialize(xmlWriter, container);
            var xmlContent = stringWriter.ToString();

            // Invoke JS download helper
            await JSRuntime.InvokeVoidAsync("wsctHelpers.downloadFile", "InteractiveData.xml", "application/xml", xmlContent);
            _statusMessage = $"Exported {InteractiveController.ActionsList.Count} actions to 'InteractiveData.xml'.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error saving recorded data: {ex.Message}";
        }
    }

    public void Dispose()
    {
        InteractiveController.InteractiveModeChangedEvent -= OnInteractiveModeChanged;
    }
}
