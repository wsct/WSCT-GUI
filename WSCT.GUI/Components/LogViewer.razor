@using WSCT.GUI.Services
@inject ILogService LogService
@implements IDisposable

<div class="card shadow-sm h-100">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
        <span class="small fw-semibold">
            <i class="bi bi-terminal me-1"></i> Live Execution Logs (@LogService.Entries.Count)
        </span>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm py-0 px-2" @onclick="LogService.Clear">
                <i class="bi bi-trash me-1"></i> Clear Logs
            </button>
        </div>
    </div>
    <div class="card-body p-2 bg-dark text-light font-monospace overflow-auto" style="height: 500px; font-size: 0.82rem;">
        @if (LogService.Entries.Count == 0)
        {
            <div class="text-secondary p-3 text-center">No logs recorded yet.</div>
        }
        else
        {
            @foreach (var entry in LogService.Entries)
            {
                <div class="text-nowrap" style="color: @(entry.Level == LogLevel.Error ? "#ff8a80" : (entry.Level == LogLevel.Warning ? "#ffd54f" : "#eceff1"))">
                    <span class="text-secondary">[@entry.FormattedTimestamp]</span>
                    <span class="badge @(entry.Level == LogLevel.Error ? "bg-danger" : (entry.Level == LogLevel.Warning ? "bg-warning text-dark" : "bg-secondary")) px-1 me-1">@entry.Level</span>
                    <span class="text-info fw-semibold">[@entry.Source]</span>
                    <span>@entry.Message</span>
                </div>
            }
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        LogService.OnLogAppended += HandleLogUpdate;
        LogService.OnLogsCleared += HandleLogCleared;
    }

    private void HandleLogUpdate(LogEntry entry)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLogCleared()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LogService.OnLogAppended -= HandleLogUpdate;
        LogService.OnLogsCleared -= HandleLogCleared;
    }
}
