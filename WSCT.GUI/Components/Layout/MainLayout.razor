@inherits LayoutComponentBase
@inject ISmartCardSessionService SessionService
@implements IDisposable

<div class="d-flex flex-column min-vh-100">
    <!-- Top Navbar -->
    <header class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-2 px-3">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="#">
                <i class="bi bi-cpu-fill text-primary fs-4"></i>
                <span>WSCT GUI</span>
            </a>

            <!-- Right-side Badges & Actions -->
            <div class="d-flex align-items-center flex-wrap gap-2 ms-auto">
                <!-- Context Status Badge -->
                <span class="badge @(SessionService.IsContextEstablished ? "bg-success" : "bg-secondary") d-flex align-items-center gap-1 py-2 px-2">
                    <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                    <span>Context: @SessionService.ContextStateText</span>
                </span>

                <!-- Channel Status Badge -->
                <span class="badge @(SessionService.ChannelStatus == ChannelStatusType.Connected ? "bg-success" : (SessionService.ChannelStatus == ChannelStatusType.Error ? "bg-danger" : "bg-secondary")) d-flex align-items-center gap-1 py-2 px-2">
                    <i class="bi bi-plug" style="font-size: 0.75rem;"></i>
                    <span>Channel: @SessionService.ChannelStatusText</span>
                </span>

                <!-- Reader in Use Badge -->
                @if (!string.IsNullOrEmpty(SessionService.ReaderInUse))
                {
                    <span class="badge bg-primary text-truncate d-flex align-items-center gap-1 py-2 px-2" style="max-width: 250px;" title="@SessionService.ReaderInUse">
                        <i class="bi bi-sim" style="font-size: 0.75rem;"></i>
                        <span>@SessionService.ReaderInUse</span>
                    </span>
                }

                <!-- Last Error Badge -->
                <span class="badge @(SessionService.LastErrorCode == WSCT.Wrapper.ErrorCode.Success ? "bg-dark border border-secondary text-secondary" : "bg-danger") py-2 px-2 font-monospace">
                    @SessionService.LastErrorText
                </span>

                <!-- About Modal Toggle -->
                <button class="btn btn-outline-light btn-sm ms-2" @onclick="() => _showAbout = true" title="About WSCT GUI">
                    <i class="bi bi-info-circle me-1"></i> About
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1 p-3">
        @Body
    </main>

    <!-- Footer -->
    <footer class="footer bg-white border-top py-2 px-3 text-muted small text-center">
        <span>WSCT GUI &copy; Sylvain Vernois / ENSICAEN - GREYC &bull; Modern Blazor Edition</span>
    </footer>
</div>

<AboutModal @bind-IsOpen="_showAbout" />

@code {
    private bool _showAbout;

    protected override void OnInitialized()
    {
        SessionService.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionService.OnStateChanged -= HandleStateChanged;
    }
}
