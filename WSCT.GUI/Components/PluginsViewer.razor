@using WSCT.GUI.Plugins
@using WSCT.GUI.Services
@inject ISmartCardSessionService SessionService

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light fw-bold py-2">
                <i class="bi bi-puzzle me-1"></i> Discovered Plugins (@SessionService.DiscoveredPlugins.Count)
            </div>
            <div class="list-group list-group-flush overflow-auto" style="max-height: 480px;">
                @if (SessionService.DiscoveredPlugins.Count == 0)
                {
                    <div class="p-3 text-muted text-center">No plugins found in application directory.</div>
                }
                else
                {
                    @foreach (var plugin in SessionService.DiscoveredPlugins)
                    {
                        var isSelected = plugin == _selectedPlugin;
                        <button type="button"
                                class="list-group-item list-group-item-action @(isSelected ? "active" : "")"
                                @onclick="() => SelectPlugin(plugin)">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1 text-truncate">@plugin.Attribute.Name</h6>
                                @if (isSelected)
                                {
                                    <span class="badge bg-light text-dark">Selected</span>
                                }
                            </div>
                            <small class="text-truncate d-block @(isSelected ? "text-light" : "text-muted")">
                                @plugin.Type.Name
                            </small>
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        @if (_selectedPlugin != null)
        {
            var asm = _selectedPlugin.Type.Assembly;
            var asmName = asm.GetName();
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold"><i class="bi bi-info-circle me-1"></i> Plugin Details: @_selectedPlugin.Attribute.Name</span>
                    @if (OnOpenPlugin.HasDelegate)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => OnOpenPlugin.InvokeAsync(_selectedPlugin)">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Open in Tab
                        </button>
                    }
                </div>
                <div class="card-body">
                    <h5 class="card-title text-primary">@_selectedPlugin.Attribute.Name</h5>
                    <p class="card-text text-muted">@_selectedPlugin.Attribute.Description</p>

                    <h6 class="border-bottom pb-1 mt-4 fw-bold text-secondary">Plugin Type Information</h6>
                    <dl class="row small mb-3">
                        <dt class="col-sm-3">Full Name:</dt>
                        <dd class="col-sm-9 font-monospace">@_selectedPlugin.Type.FullName</dd>
                    </dl>

                    <h6 class="border-bottom pb-1 mt-4 fw-bold text-secondary">Assembly Information</h6>
                    <dl class="row small mb-0">
                        <dt class="col-sm-3">Assembly Name:</dt>
                        <dd class="col-sm-9 font-monospace">@asmName.Name</dd>

                        <dt class="col-sm-3">Version:</dt>
                        <dd class="col-sm-9 font-monospace">@asmName.Version</dd>

                        <dt class="col-sm-3">Location:</dt>
                        <dd class="col-sm-9 font-monospace text-truncate" title="@asm.Location">@asm.Location</dd>
                    </dl>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm h-100 d-flex align-items-center justify-content-center p-5 text-muted">
                <i class="bi bi-arrow-left-circle display-4 mb-2"></i>
                <div>Select a plugin from the list to view its details.</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<PluginInfo> OnOpenPlugin { get; set; }

    private PluginInfo? _selectedPlugin;

    protected override void OnInitialized()
    {
        _selectedPlugin = SessionService.DiscoveredPlugins.FirstOrDefault();
    }

    private void SelectPlugin(PluginInfo plugin)
    {
        _selectedPlugin = plugin;
    }
}
